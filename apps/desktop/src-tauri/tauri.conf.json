{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "driftnet",
  "version": "1.3.0",
  "identifier": "io.github.kevinchu1110.driftnet",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/driftnet-server"
    ],
    "resources": [
      "resources/public/**/*",
      "resources/skills/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
