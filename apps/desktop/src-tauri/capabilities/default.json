{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for driftnet menu bar wrapper",
  "windows": [],
  "permissions": [
    "core:default",
    "opener:default",
    "autostart:default",
    "clipboard-manager:allow-read-text",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/driftnet-server",
          "sidecar": true,
          "args": ["start"]
        }
      ]
    }
  ]
}
