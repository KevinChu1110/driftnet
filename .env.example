# ── Models ─────────────────────────────────────────────────────────────
# Summaries (the only LLM call). Without it, items are still judged and stored.
# Deliberately NOT ANTHROPIC_API_KEY: if that is exported, Claude Code switches
# from your subscription to API billing.
DRIFTNET_ANTHROPIC_API_KEY=
DRIFTNET_SUMMARY_MODEL=claude-haiku-5-5
# low | medium | high | xhigh — a typo falls back to low with a warning
DRIFTNET_SUMMARY_EFFORT=low
# Language for one-liners and highlights, e.g. "Traditional Chinese (Taiwan)", "Japanese"
DRIFTNET_LANGUAGE=English

# Jev judge (https://console.typesafe.ai) — optional accelerator. Also read from ~/.typesafe/api_key
TYPESAFE_API_KEY=
# Below this category confidence, the LLM classifies instead of Jev (0..1)
DRIFTNET_MIN_CONFIDENCE=0.4

# Optional: raises GitHub API limits from 60 to 5000 requests/hour
GITHUB_TOKEN=

# ── Server ─────────────────────────────────────────────────────────────
PORT=8787
DRIFTNET_DB=./data/driftnet.db
# Required for writes (ingest, feedback, MCP) when the server is reachable from the internet
DRIFTNET_TOKEN=
# Public URL of this server; replies link to the item on the web page
DRIFTNET_PUBLIC_URL=
# Your own shelves: JSON file of { "id": "description" }
DRIFTNET_CATEGORIES=

# ── Chat platforms (set the ones you use) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
