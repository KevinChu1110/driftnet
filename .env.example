# ── Models ─────────────────────────────────────────────────────────────
# Summaries (the only LLM call). Leave DRIFTNET_LLM_PROVIDER empty to run without
# one: items are still extracted, judged (with Jev) and listed.
#
#   anthropic  Claude via the official SDK
#   openai     any OpenAI-compatible API — OpenAI, Gemini, Grok, DeepSeek,
#              OpenRouter, LiteLLM, Ollama, LM Studio… (set DRIFTNET_LLM_BASE_URL)
#   claude-cli your Claude subscription via a logged-in Claude Code on this machine (no key)
#   gemini-cli your Google account via a logged-in Gemini CLI on this machine (no key)
#
# driftnet never reads ANTHROPIC_API_KEY / OPENAI_API_KEY: exporting those changes
# how other tools bill you (Claude Code moves from subscription to API billing).
DRIFTNET_LLM_PROVIDER=
DRIFTNET_LLM_MODEL=
DRIFTNET_LLM_API_KEY=
DRIFTNET_LLM_BASE_URL=
# anthropic: low | medium | high | xhigh (typo → low). openai: sent as reasoning_effort.
DRIFTNET_LLM_EFFORT=
# Language of the summaries and the bot's replies: "English" or "Traditional Chinese (Taiwan)"
# (summaries also work in other languages, e.g. "Japanese"; bot replies then fall back to English)
DRIFTNET_LANGUAGE=English
# Force the bot's own words: en | zh-TW (default: follows DRIFTNET_LANGUAGE)
DRIFTNET_LOCALE=

# Examples:
#   DRIFTNET_LLM_PROVIDER=anthropic  DRIFTNET_LLM_MODEL=claude-haiku-5-5
#   DRIFTNET_LLM_PROVIDER=openai     DRIFTNET_LLM_MODEL=gpt-5-mini
#   DRIFTNET_LLM_PROVIDER=openai     DRIFTNET_LLM_MODEL=gemini-3.8-flash  DRIFTNET_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   DRIFTNET_LLM_PROVIDER=openai     DRIFTNET_LLM_MODEL=qwen3             DRIFTNET_LLM_BASE_URL=http://localhost:11434/v1
#   DRIFTNET_LLM_PROVIDER=claude-cli                                       (model defaults to haiku)
#   DRIFTNET_LLM_PROVIDER=gemini-cli DRIFTNET_LLM_MODEL=gemini-3.5-flash-lite
# CLI providers: binary path and parallelism
DRIFTNET_CLI_PATH=
DRIFTNET_CLI_CONCURRENCY=1

# Jev judge (https://console.typesafe.ai) — optional accelerator. Also read from ~/.typesafe/api_key
TYPESAFE_API_KEY=
# Below this category confidence, the LLM classifies instead of Jev (0..1)
DRIFTNET_MIN_CONFIDENCE=0.4

# Optional: raises GitHub API limits from 60 to 5000 requests/hour
GITHUB_TOKEN=

# ── Server ─────────────────────────────────────────────────────────────
PORT=8787
# Listen address. 127.0.0.1 by default; use 0.0.0.0 inside a container
DRIFTNET_HOST=
DRIFTNET_DB=./data/driftnet.db
# Required for writes (ingest, feedback, MCP) when the server is reachable from the internet
DRIFTNET_TOKEN=
# public: anyone can read, writes need the token | private: every read needs the token too
DRIFTNET_ACCESS=public
# Token budget for the page outline sent to the judge and the model
DRIFTNET_DIGEST_TOKENS=350
# Public URL of this server; replies link to the item on the web page
DRIFTNET_PUBLIC_URL=
# Your own shelves: JSON file of { "id": "description" }
DRIFTNET_CATEGORIES=

# ── Chat platforms (set the ones you use) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
