{
  "name": "driftnet",
  "version": "1.0.0",
  "description": "Search, save and file the links people share in your chats (tools, repos, articles): a local catalogue your agent checks before picking a tool, and helps keep tidy.",
  "author": {
    "name": "Kevin Chu",
    "url": "https://github.com/KevinChu1110"
  },
  "homepage": "https://github.com/KevinChu1110/driftnet",
  "repository": "https://github.com/KevinChu1110/driftnet",
  "license": "MIT",
  "keywords": [
    "bookmarks",
    "links",
    "ai-tools",
    "catalogue",
    "mcp"
  ],
  "mcpServers": {
    "driftnet": {
      "command": "npx",
      "args": [
        "-y",
        "driftnet",
        "mcp"
      ],
      "env": {
        "DRIFTNET_AGENT": "claude-code"
      }
    }
  }
}
